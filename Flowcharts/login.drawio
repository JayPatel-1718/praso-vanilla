        <mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="1" source="registerInput" target="firebaseCreate"/>
        
        <mxCell id="storeData" value="Store User Data (optional)" style="rounded=1;fillColor=#FFF3E0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="30" width="180" height="60" as="geometry"/>
